{{!-- Search: a command line at the bottom of the screen. Filled in by main.js. --}}
<div class="search" data-search-panel hidden>
    <div class="search-backdrop" data-search-close></div>
    <section class="search-box" role="dialog" aria-modal="true" aria-labelledby="search-label">
        <div class="search-head"><span class="k">搜尋 search</span><span class="dim" data-search-status></span></div>
        <ol class="search-results" id="search-results" role="listbox" aria-label="Results" data-search-results></ol>
        <form class="search-line" data-search-form>
            <label id="search-label" for="search-input"><span class="ps">/</span> search:</label>
            <input id="search-input" type="search" autocomplete="off" autocapitalize="off" spellcheck="false" role="combobox" aria-controls="search-results" aria-expanded="true" aria-autocomplete="list" data-search-input>
        </form>
        <p class="search-keys dim small"><span class="keys"><kbd>↑</kbd><kbd>↓</kbd> 移動 <kbd>Enter</kbd> 閱讀 <kbd>Esc</kbd> 離開</span> <button type="button" class="search-x" data-search-close>[x] close</button></p>
    </section>
</div>

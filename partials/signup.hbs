{{!-- A subscribe link for the site's membership settings: the theme's form for free signup, Portal
     for paid tiers or required terms, nothing when invite-only.
     Hash params: class, label, switch (render a button that switches the open dialog to signup). --}}
{{#unless @site.members_invite_only}}{{#if @site.paid_members_enabled}}<a{{#if class}} class="{{class}}"{{/if}} href="#/portal/signup" data-portal="signup">{{label}}</a>{{else if @site.portal_signup_checkbox_required}}<a{{#if class}} class="{{class}}"{{/if}} href="#/portal/signup" data-portal="signup">{{label}}</a>{{else if @site.allow_self_signup}}{{#if switch}}<button type="button"{{#if class}} class="{{class}}"{{/if}} data-member-mode="signup">{{label}}</button>{{else}}<a{{#if class}} class="{{class}}"{{/if}} href="#/portal/signup" data-member="signup" aria-haspopup="dialog">{{label}}</a>{{/if}}{{else}}<a{{#if class}} class="{{class}}"{{/if}} href="#/portal/signup" data-portal="signup">{{label}}</a>{{/if}}{{/unless}}
